    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nview3d = UnwrapElement(IN[0])\r\n\r\nif isinstance(view3d, View3D) and view3d.IsPerspective:\r\n    # Extract Camera Orientation\r\n    orientation = view3d.GetOrientation()\r\n    \r\n    # Converts Revit Internal Feet to Meters for WebGL (Three.js)\r\n    eye = [round(orientation.EyePosition.X * 0.3048, 2), \r\n           round(orientation.EyePosition.Y * 0.3048, 2), \r\n           round(orientation.EyePosition.Z * 0.3048, 2)]\r\n           \r\n    forward_vector = orientation.ForwardDirection\r\n    \r\n    # Calculate target point 5 meters in front of the camera direction\r\n    target = [round(eye[0] + forward_vector.X * 5.0, 2),\r\n              round(eye[1] + forward_vector.Y * 5.0, 2),\r\n              round(eye[2] + forward_vector.Z * 5.0, 2)]\r\n\r\n    OUT = { \"eye\": eye, \"target\": target }\r\nelse:\r\n    OUT = \"Selected View is not a 3D Perspective Camera View.\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "88ae8622f5cc4fd6a3c33173a4c25b82",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "0d92c2562e8446c68093f99ff90c30d8",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "f7bb4d4ce36e4ac783805b80c04fc113",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    }
