          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4f9f7b64d34747b5848ada5737d3e912",
          "Name": "Elements",
          "Description": "An element class.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Get all elements of the specified category from the model."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport json\r\n\r\n# Import Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Unwrap Dynamo elements\r\nrooms = UnwrapElement(IN[0]) if isinstance(IN[0], list) else [UnwrapElement(IN[0])]\r\nfurniture_list = UnwrapElement(IN[1]) if isinstance(IN[1], list) else [UnwrapElement(IN[1])]\r\n\r\nbuilding_dataset = {\r\n    \"building\": {\r\n        \"id\": \"toronto_building_01\",\r\n        \"name\": \"Toronto Tower\",\r\n        \"floors\": 12,\r\n        \"levels\": []\r\n    }\r\n}\r\n\r\nlevel_dict = {}\r\n\r\n# 1. Process Rooms\r\nfor room in rooms:\r\n    if not room or room.Area == 0:  # Skip unplaced or unbounded rooms\r\n        continue\r\n        \r\n    level_name = room.Level.Name if room.Level else \"Level 01\"\r\n    room_id = room.UniqueId\r\n    room_number = room.Number\r\n    room_name = room.get_Parameter(BuiltInParameter.ROOM_NAME).AsString()\r\n    room_area = round(room.Area * 0.092903, 2)  # Sq.Ft to Sq.Meters\r\n    \r\n    if level_name not in level_dict:\r\n        level_dict[level_name] = {\r\n            \"id\": level_name.replace(\" \", \"_\"),\r\n            \"name\": level_name,\r\n            \"rooms\": []\r\n        }\r\n        \r\n    # Find furniture located inside this room using spatial/phase check safely\r\n    room_assets = []\r\n    for furn in furniture_list:\r\n        if not furn:\r\n            continue\r\n        \r\n        # Safe extraction for CPython3\r\n        furn_room = None\r\n        try:\r\n            # Check phase-assigned room safely\r\n            phase = doc.GetElement(furn.CreatedPhaseId)\r\n            if hasattr(furn, 'get_Room'):\r\n                furn_room = furn.get_Room(phase)\r\n            elif hasattr(furn, 'Room'):\r\n                furn_room = furn.Room\r\n        except:\r\n            pass\r\n\r\n        if furn_room and furn_room.UniqueId == room_id:\r\n            # Extract Shared Parameters safely\r\n            param_data = {}\r\n            for param in furn.Parameters:\r\n                if param.IsShared and param.HasValue:\r\n                    val = param.AsString()\r\n                    if not val:\r\n                        val = str(round(param.AsDouble(), 2))\r\n                    param_data[param.Definition.Name] = val\r\n            \r\n            fam_name = furn.Symbol.Family.Name if hasattr(furn, 'Symbol') else \"Generic\"\r\n            \r\n            room_assets.append({\r\n                \"id\": furn.UniqueId,\r\n                \"family\": fam_name,\r\n                \"type\": furn.Name,\r\n                \"shared_parameters\": param_data\r\n            })\r\n\r\n    level_dict[level_name][\"rooms\"].append({\r\n        \"id\": room_id,\r\n        \"number\": room_number,\r\n        \"name\": room_name,\r\n        \"area_sqm\": room_area,\r\n        \"camera\": { \"eye\": [0, 0, 0], \"target\": [0, 0, 0] },\r\n        \"assets\": room_assets\r\n    })\r\n\r\n# Format into output dictionary\r\nfor lvl in level_dict.values():\r\n    building_dataset[\"building\"][\"levels\"].append(lvl)\r\n\r\nOUT = json.dumps(building_dataset, indent=2)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "dea72961be214ce38078953d679ea65f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "ddcd5c9c02e546b5881830688e6dad9f",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3d16f3884cfe41a0a9aca1a344010ad4",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a9e0687bd48f40dbba2294f039f343bc",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
