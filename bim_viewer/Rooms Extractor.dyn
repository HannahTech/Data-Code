      "ConcreteType": "DSRevitNodesUI.Categories, DSRevitNodesUI",
      "SelectedIndex": 435,
      "SelectedString": "OST_Planting",
      "Id": "e819757a60b5403387c9391a1d2fb27a",
      "NodeType": "ExtensionNode",
      "Inputs": [],
